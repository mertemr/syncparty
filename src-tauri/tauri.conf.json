{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syncparty",
  "version": "0.3.2",
  "identifier": "com.tahckn.syncparty",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "syncparty",
        "width": 940,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["syncparty"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Tahckn/syncparty/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFOTBGQUVFNDFBQjg4ODUKUldTRmlLdEI3dnFRSGxnWWx2dUtuNFJBQXladjlDczdLRnhaSGNkTXhIb2FWSnUyVUJIK0FQVncK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Video",
    "shortDescription": "Synchronised movie nights, peer to peer",
    "longDescription": "syncparty runs a private Syncplay server on your machine and connects your friends to it directly, with no account to create and no port to open. Nothing is streamed and nothing is exposed to the public internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
